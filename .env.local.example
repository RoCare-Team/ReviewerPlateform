# Copy to .env.local and fill in. .env* is gitignored — never commit the real file.

# --- Core ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/reviewhub

# --- Google OAuth (sign-in identity ONLY) -------------------------------
# Scope is openid/email/profile. This is NOT the Google Business Profile
# connection — GBP needs its own client, its own consent screen, and the
# business.manage scope. Do not reuse these credentials for it.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Google Business Profile (GBP/GMB connection — SEPARATE from sign-in) --
# A DIFFERENT OAuth client from AUTH_GOOGLE_* above. This one carries the
# business.manage scope and is used only to connect a business owner's GMB
# account(s) and fetch reviews. Never reuse the sign-in client here.
# Authorised redirect URI (add in Google Cloud console):
#   http://localhost:3000/api/business/gmb/callback
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=

# --- Cloudinary (review screenshot uploads) -----------------------------
# From your Cloudinary dashboard. Screenshots are uploaded here (signed), never
# stored on the app server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OpenAI (AI review-screenshot verification) -------------------------
# Used to auto-verify reviewer screenshots (gpt-4o-mini vision). Without it,
# submissions stay pending for manual admin verification.
OPENAI_API_KEY=

# --- SMTP (OTP + password reset + contact enquiries) ---------------------
# Leave SMTP_HOST empty in dev and codes print to the server console instead.
# Gmail account that SENDS the mail (can be the owner's Gmail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail APP PASSWORD (NOT your normal password). Create one at:
# https://myaccount.google.com/apppasswords
# (2-Step Verification must be ON for the account first)
SMTP_PASS=
MAIL_FROM="RapportLook <no-reply@rapportlook.com>"
# Where contact-form enquiries are delivered. Defaults to SITE.email if blank.
CONTACT_TO=

# --- Razorpay (business wallet top-ups + reviewer payouts) --------------
# Standard API key pair, from Settings → API Keys in the Razorpay dashboard.
# Used both for Checkout (top-ups) and as the auth for RazorpayX (payouts) —
# RazorpayX does NOT use a separate key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → create one pointed at
# https://yourdomain.com/api/webhooks/razorpay with events: payment.captured,
# payout.processed, payout.failed, payout.reversed. Paste the secret you set
# there (not the API secret above).
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX current account number that reviewer payouts are debited from —
# RazorpayX dashboard → Accounts. Only needed for automated reviewer
# withdrawals; top-ups work without it.
RAZORPAYX_ACCOUNT_NUMBER=
